generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Classroom {
  id           String       @id @default(uuid()) @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  name         String       @db.VarChar(120)
  subject      String       @db.VarChar(120)
  description  String?      @db.Text
  section      String?      @db.VarChar(80)
  academicYear String       @map("academic_year") @db.VarChar(40)
  joinCode     String       @unique @map("join_code") @db.VarChar(8)
  termEnd      DateTime?    @map("term_end") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollments  Enrollment[]

  @@index([teacherId, createdAt])
  @@map("classroom")
}

model Enrollment {
  classroomId String    @map("classroom_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
  @@index([studentId, joinedAt])
  @@map("enrollment")
}
