{
  "name": "@icarus/identity-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && tsx watch src/index.ts",
    "dev:container": "prisma migrate deploy && tsx watch src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "check-types": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@icarus/contracts": "*",
    "@icarus/service-kit": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "6.1.0",
    "jose": "^6.1.0",
    "multer": "2.0.2",
    "pg": "8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/cookie-parser": "^1.4.9",
    "@types/multer": "2.0.0",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3"
  }
}
