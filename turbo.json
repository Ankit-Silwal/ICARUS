{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SERVICE_NAME",
    "WEB_ORIGINS",
    "DATABASE_URL",
    "INTERNAL_SERVICE_TOKEN",
    "PLATFORM_ADMIN_EMAIL",
    "PLATFORM_ADMIN_NAME",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "ALLOWED_EMAIL_DOMAINS",
    "STUDENT_SELF_REGISTRATION",
    "SESSION_COOKIE_NAME",
    "SESSION_TTL_HOURS",
    "OAUTH_STATE_TTL_MINUTES",
    "COOKIE_SECURE",
    "MAX_TEACHER_IMPORT_ROWS",
    "MAX_TEACHER_IMPORT_BYTES",
    "COOKIE_DOMAIN",
    "ADMIN_APP_URL",
    "TEACHER_APP_URL",
    "STUDENT_APP_URL",
    "PUBLIC_API_URL",
    "NEXT_PUBLIC_API_URL",
    "JUDGE0_URL",
    "JUDGE0_TOKEN",
    "JUDGE0_CPP_ID",
    "JUDGE0_JAVA_ID",
    "JUDGE0_PYTHON_ID",
    "JUDGE0_JAVASCRIPT_ID",
    "IDENTITY_URL",
    "CLASSROOM_URL",
    "LEETCODE_API_URL",
    "LEETCODE_GRAPHQL_URL",
    "ASSESSMENT_URL",
    "EXECUTION_URL",
    "INTEGRITY_URL",
    "REDIS_URL",
    "DISABLE_EXECUTION_WORKER",
    "EXECUTION_CONCURRENCY",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
