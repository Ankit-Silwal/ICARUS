# Copy to judge0.conf for local development only and replace both passwords.
JUDGE0_TELEMETRY_ENABLE=false
REDIS_HOST=judge0-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-local-redis-password
POSTGRES_HOST=judge0-db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace-local-postgres-password
RAILS_ENV=production
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
ENABLE_WAIT_RESULT=false
ENABLE_CALLBACKS=false
COUNT=2
MAX_QUEUE_SIZE=100
CPU_TIME_LIMIT=3
MAX_CPU_TIME_LIMIT=5
WALL_TIME_LIMIT=8
MAX_WALL_TIME_LIMIT=10
MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=256000
