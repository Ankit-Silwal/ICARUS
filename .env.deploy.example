NODE_ENV=production

# Use URL-safe random values. Never commit the populated environment file.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

PLATFORM_ADMIN_EMAIL=admin@example.edu
PLATFORM_ADMIN_NAME=College Administrator
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ALLOWED_EMAIL_DOMAINS=example.edu
STUDENT_SELF_REGISTRATION=false
SESSION_COOKIE_NAME=icarus_session
SESSION_TTL_HOURS=8
OAUTH_STATE_TTL_MINUTES=10
MAX_TEACHER_IMPORT_ROWS=2000
MAX_TEACHER_IMPORT_BYTES=2000000

API_DOMAIN=api.staging.example.edu
STUDENT_DOMAIN=student.staging.example.edu
TEACHER_DOMAIN=teacher.staging.example.edu
ADMIN_DOMAIN=admin.staging.example.edu
COOKIE_DOMAIN=.staging.example.edu

INTEGRITY_RETENTION_DAYS=180
MAX_EVENT_BATCH_SIZE=100
MAX_EVENT_CLOCK_SKEW_SECONDS=300
EXECUTION_CONCURRENCY=2
